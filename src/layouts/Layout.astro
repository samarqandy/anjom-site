---
import '@fontsource-variable/onest'
import '../styles/global.css'
import fontLatin from '@fontsource-variable/onest/files/onest-latin-wght-normal.woff2?url'
import fontCyrillic from '@fontsource-variable/onest/files/onest-cyrillic-wght-normal.woff2?url'

import { site } from '../config'
import { alternatesFor } from '../seo'
import type { Content } from '../i18n/uz'

interface Props {
  t: Content
  title?: string
  description?: string
  noindex?: boolean
}

const { t, title = t.meta.title, description = t.meta.description, noindex = false } =
  Astro.props

const canonical = new URL(t.path, site.url).toString()
const alternates = noindex ? [] : alternatesFor(t.path)
// The subset the page is actually written in: it is the one that would otherwise
// arrive after the first paint and move the text.
const primaryFont = t.lang === 'ru' ? fontCyrillic : fontLatin
const ogImage = new URL(`/og-${t.lang}.png`, site.url).toString()

const structured = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${site.url}/#org`,
      name: site.name,
      url: site.url,
      logo: new URL('/logo.png', site.url).toString(),
    },
    {
      '@type': 'WebSite',
      '@id': `${site.url}/#website`,
      name: site.name,
      url: site.url,
      inLanguage: ['uz', 'ru'],
      publisher: { '@id': `${site.url}/#org` },
    },
    {
      '@type': 'SoftwareApplication',
      '@id': `${canonical}#software`,
      name: site.name,
      url: canonical,
      applicationCategory: 'BusinessApplication',
      operatingSystem: 'Web, Telegram',
      inLanguage: t.htmlLang,
      description,
      // Only what the product does today; no price, rating or review is claimed.
      featureList: t.meta.features,
      publisher: { '@id': `${site.url}/#org` },
      isPartOf: { '@id': `${site.url}/#website` },
    },
  ],
}
---

<!doctype html>
<html lang={t.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {!noindex && <meta name="robots" content="index, follow, max-image-preview:large" />}
    <link rel="preload" href={primaryFont} as="font" type="font/woff2" crossorigin />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    {
      !noindex &&
        alternates.map((alt) => <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />)
    }

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#1f5fd6" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={t.ogLocale} />
    {!noindex && <meta property="og:locale:alternate" content={t.lang === 'uz' ? 'ru_RU' : 'uz_UZ'} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t.meta.ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />

    {!noindex && <script type="application/ld+json" set:html={JSON.stringify(structured)} />}
  </head>
  <body class="min-h-screen">
    <slot />
  </body>
</html>
