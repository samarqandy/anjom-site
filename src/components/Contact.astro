---
import { hasContacts, phoneLink, site, telegramLink } from '../config'
import type { Content } from '../i18n/uz'
import CheckList from './CheckList.astro'
import Icon from './Icon.astro'
import SectionHeader from './SectionHeader.astro'

interface Props {
  t: Content
}
const { t } = Astro.props
const f = t.contact.form
const { telegram, phone, email } = site.contacts
const field =
  'mt-1.5 block w-full rounded-xl border border-line bg-white px-3.5 text-[16px] text-ink placeholder:text-faint transition-colors focus:border-brand focus:outline-none focus:ring-4 focus:ring-brand/10'
---

<section id="ariza" class="relative overflow-hidden bg-white py-16 sm:py-24" aria-labelledby="ariza-title">
  <div class="glow pointer-events-none absolute inset-0 opacity-70"></div>
  <div class="relative mx-auto grid w-full max-w-[1200px] gap-10 px-4 sm:px-6 lg:grid-cols-12 lg:gap-14">
    <div class="lg:col-span-5">
      <SectionHeader
        id="ariza-title"
        eyebrow={t.contact.eyebrow}
        title={t.contact.title}
        align="left"
      />
      <p class="mt-4 text-[17px] leading-relaxed text-muted">{t.contact.text}</p>
      <CheckList items={t.contact.points} class="mt-7" />

      {
        hasContacts && (
          <div class="mt-9">
            <p class="text-[14px] font-semibold text-ink-2">{t.contact.contactsTitle}</p>
            <div class="mt-3 flex flex-col gap-2.5">
              {telegram && (
                <a
                  href={telegramLink(telegram, t.contact.telegramText)}
                  class="flex items-center gap-3 rounded-xl border border-line bg-white px-4 py-3 transition-colors hover:border-brand/40"
                >
                  <Icon name="Send" size={19} class="text-[#229ed9]" />
                  <span class="text-[15px] text-ink">
                    <span class="text-muted">{t.contact.telegramLabel}: </span>
                    {`@${telegram.replace(/^@/, '')}`}
                  </span>
                </a>
              )}
              {phone && (
                <a
                  href={phoneLink(phone)}
                  class="flex items-center gap-3 rounded-xl border border-line bg-white px-4 py-3 transition-colors hover:border-brand/40"
                >
                  <Icon name="Phone" size={19} class="text-brand" />
                  <span class="text-[15px] text-ink">
                    <span class="text-muted">{t.contact.phoneLabel}: </span>
                    {phone}
                  </span>
                </a>
              )}
              {email && (
                <a
                  href={`mailto:${email}`}
                  class="flex items-center gap-3 rounded-xl border border-line bg-white px-4 py-3 transition-colors hover:border-brand/40"
                >
                  <Icon name="Mail" size={19} class="text-brand" />
                  <span class="text-[15px] text-ink">
                    <span class="text-muted">{t.contact.emailLabel}: </span>
                    {email}
                  </span>
                </a>
              )}
            </div>
          </div>
        )
      }
    </div>

    <div class="lg:col-span-7">
      <form
        id="lead-form"
        method="post"
        action="/api/lead"
        novalidate
        class="rounded-3xl border border-line bg-white p-5 shadow-[0_30px_70px_-40px_rgba(15,23,40,0.45)] sm:p-8"
        data-lang={t.lang}
        data-sending={f.sending}
        data-success={f.success}
        data-error={f.error}
        data-invalid={f.invalid}
      >
        <input type="hidden" name="lang" value={t.lang} />
        <!-- Humans never see this field; bots that fill every input do. -->
        <div class="absolute -left-[9999px]" aria-hidden="true">
          <label>Website <input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
        </div>

        <div class="grid gap-4 sm:grid-cols-2">
          <label class="block">
            <span class="text-[14px] font-medium text-ink-2">{f.name}</span>
            <input
              name="name"
              required
              minlength="2"
              maxlength="80"
              autocomplete="name"
              placeholder={f.namePlaceholder}
              class:list={[field, 'h-12']}
            />
          </label>
          <label class="block">
            <span class="text-[14px] font-medium text-ink-2">{f.phone}</span>
            <span
              class="mt-1.5 flex h-12 items-center rounded-xl border border-line bg-white transition-colors focus-within:border-brand focus-within:ring-4 focus-within:ring-brand/10"
            >
              <span class="pr-1.5 pl-3.5 text-[16px] text-muted">+998</span>
              <input
                name="phone"
                type="tel"
                required
                inputmode="tel"
                autocomplete="tel-national"
                maxlength="20"
                placeholder={f.phonePlaceholder}
                class="h-full w-full min-w-0 rounded-r-xl bg-transparent pr-3.5 text-[16px] text-ink placeholder:text-faint focus:outline-none"
              />
            </span>
          </label>
        </div>

        <label class="mt-4 block">
          <span class="text-[14px] font-medium text-ink-2">{f.business}</span>
          <select name="business" class:list={[field, 'h-12 appearance-none bg-[length:18px] bg-[right_0.9rem_center] bg-no-repeat pr-10']} style="background-image:url(&quot;data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%23566174' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'%3E%3Cpath d='m6 9 6 6 6-6'/%3E%3C/svg%3E&quot;)">
            <option value="">{f.businessPlaceholder}</option>
            {f.businessOptions.map((option) => <option value={option}>{option}</option>)}
          </select>
        </label>

        <label class="mt-4 block">
          <span class="text-[14px] font-medium text-ink-2">{f.message}</span>
          <textarea
            name="message"
            rows="3"
            maxlength="1000"
            placeholder={f.messagePlaceholder}
            class:list={[field, 'resize-y py-3']}></textarea>
        </label>

        <button
          type="submit"
          class="mt-6 inline-flex h-12 w-full items-center justify-center gap-2 rounded-xl bg-brand px-6 text-[16px] font-semibold text-white shadow-[0_10px_24px_-10px_rgba(31,95,214,0.7)] transition-colors hover:bg-brand-600 disabled:cursor-wait disabled:opacity-70"
        >
          <span data-label>{f.submit}</span>
          <Icon name="ArrowRight" size={18} strokeWidth={2.25} />
        </button>

        <p data-status role="status" aria-live="polite" class="mt-4 hidden rounded-xl px-4 py-3 text-[15px]"></p>

        <p class="mt-4 flex items-center gap-2 text-[13px] text-faint">
          <Icon name="Lock" size={14} />
          {f.privacy}
        </p>
      </form>
    </div>
  </div>
</section>

<script>
  const form = document.querySelector<HTMLFormElement>('#lead-form')
  const opened = Date.now()

  if (form) {
    const status = form.querySelector<HTMLElement>('[data-status]')!
    const button = form.querySelector<HTMLButtonElement>('button[type=submit]')!
    const label = button.querySelector<HTMLElement>('[data-label]')!
    const idle = label.textContent ?? ''

    const show = (text: string, ok: boolean) => {
      status.textContent = text
      status.className = `mt-4 rounded-xl px-4 py-3 text-[15px] ${
        ok ? 'bg-ok-soft text-ok' : 'bg-danger-soft text-danger'
      }`
    }

    form.addEventListener('submit', async (event) => {
      event.preventDefault()
      const data = Object.fromEntries(new FormData(form)) as Record<string, string>
      const digits = (data.phone ?? '').replace(/\D/g, '')
      if ((data.name ?? '').trim().length < 2 || digits.length < 9) {
        show(form.dataset.invalid ?? '', false)
        return
      }

      button.disabled = true
      label.textContent = form.dataset.sending ?? idle
      try {
        const response = await fetch(form.action, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({ ...data, elapsed: Date.now() - opened }),
        })
        if (response.ok) {
          show(form.dataset.success ?? '', true)
          form.reset()
        } else {
          show(
            (response.status === 400 ? form.dataset.invalid : form.dataset.error) ?? '',
            false,
          )
        }
      } catch {
        show(form.dataset.error ?? '', false)
      } finally {
        button.disabled = false
        label.textContent = idle
      }
    })
  }
</script>
