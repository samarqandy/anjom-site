---
import type { Content } from '../i18n/uz'
import Icon from './Icon.astro'
import SectionHeader from './SectionHeader.astro'

interface Props {
  t: Content
}
const { t } = Astro.props
---

<section id="imkoniyatlar" class="bg-white py-16 sm:py-24" aria-labelledby="imkoniyatlar-title">
  <div class="mx-auto w-full max-w-[1200px] px-4 sm:px-6">
    <SectionHeader
      id="imkoniyatlar-title"
      eyebrow={t.features.eyebrow}
      title={t.features.title}
      lead={t.features.lead}
    />

    <div class="mt-12 grid gap-x-6 gap-y-8 sm:grid-cols-2 lg:grid-cols-3 lg:gap-y-10">
      {
        t.features.items.map((item) => (
          <article class="flex gap-4">
            <span class="grid size-11 shrink-0 place-items-center rounded-xl bg-brand-50 text-brand">
              <Icon name={item.icon} size={22} />
            </span>
            <div>
              <h3 class="text-[17px] font-semibold text-ink">{item.title}</h3>
              <p class="mt-1.5 text-[15px] leading-relaxed text-muted">{item.text}</p>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
