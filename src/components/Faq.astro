---
import type { Content } from '../i18n/uz'
import Icon from './Icon.astro'
import SectionHeader from './SectionHeader.astro'

interface Props {
  t: Content
}
const { t } = Astro.props

const structured = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: t.faq.items.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
}
---

<section id="savollar" class="py-16 sm:py-24" aria-labelledby="savollar-title">
  <div class="mx-auto w-full max-w-[860px] px-4 sm:px-6">
    <SectionHeader id="savollar-title" eyebrow={t.faq.eyebrow} title={t.faq.title} />
    <div class="mt-10 divide-y divide-line rounded-2xl border border-line bg-white">
      {
        t.faq.items.map((item, index) => (
          <details class="group" open={index === 0}>
            <summary class="flex cursor-pointer items-center justify-between gap-4 px-5 py-4 text-left sm:px-6 sm:py-5">
              <span class="text-[16px] font-semibold text-ink sm:text-[17px]">{item.q}</span>
              <span class="grid size-8 shrink-0 place-items-center rounded-full bg-canvas text-muted transition-transform group-open:rotate-180">
                <Icon name="ChevronDown" size={18} />
              </span>
            </summary>
            <p class="px-5 pb-5 text-[15px] leading-relaxed text-muted sm:px-6 sm:text-[16px]">
              {item.a}
            </p>
          </details>
        ))
      }
    </div>
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(structured)} />
</section>
