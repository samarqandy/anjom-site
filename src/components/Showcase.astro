---
/**
 * Text on one side, the product on the other. `reverse` puts the picture on
 * the left, so consecutive sections zig-zag instead of stacking one way.
 */
import CheckList from './CheckList.astro'
import SectionHeader from './SectionHeader.astro'

interface Props {
  id?: string
  eyebrow: string
  title: string
  text: string
  bullets: string[]
  reverse?: boolean
  class?: string
}
const { id, eyebrow, title, text, bullets, reverse = false, class: className } = Astro.props
const titleId = id ? `${id}-title` : undefined
---

<section id={id} class:list={['py-16 sm:py-24', className]} aria-labelledby={titleId}>
  <div
    class="mx-auto grid w-full max-w-[1200px] items-center gap-10 px-4 sm:px-6 lg:grid-cols-12 lg:gap-14"
  >
    <div class:list={['lg:col-span-5', reverse && 'lg:order-2']}>
      <SectionHeader id={titleId} eyebrow={eyebrow} title={title} align="left" />
      <p class="mt-4 text-[17px] leading-relaxed text-pretty text-muted">{text}</p>
      <CheckList items={bullets} class="mt-7" />
      <slot name="after" />
    </div>
    <div class:list={['min-w-0 lg:col-span-7', reverse && 'lg:order-1']}>
      <slot />
    </div>
  </div>
</section>
