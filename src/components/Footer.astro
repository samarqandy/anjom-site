---
import { company, phoneLink, site, telegramLink } from '../config'
import Icon from './Icon.astro'
import type { Content } from '../i18n/uz'
import Logo from './Logo.astro'

interface Props {
  t: Content
  /** Where the page anchors live: empty on the landing page, the landing page's path elsewhere. */
  base?: string
  /** The same page in the other language, when it is not the landing page. */
  switchHref?: string
}
const { t, base = '', switchHref = t.nav.switchHref } = Astro.props
const year = new Date().getFullYear()
const { telegram, phone, email } = site.contacts
---

<footer class="bg-night text-white">
  <div class="mx-auto w-full max-w-[1200px] px-4 py-12 sm:px-6">
    <div class="flex flex-col gap-8 sm:flex-row sm:items-start sm:justify-between">
      <div>
        <Logo tone="dark" />
        <p class="mt-3 max-w-[320px] text-[15px] text-white/60">{t.footer.tagline}</p>
        <p class="mt-2 max-w-[320px] text-[14px] text-white/60">
          {t.footer.productBefore}<a href={company.url} class="text-white/80 underline-offset-2 hover:text-white hover:underline">{company.name}</a>{t.footer.productAfter}
        </p>
        {
          (phone || telegram || email) && (
            <ul class="mt-4 space-y-2 text-[15px] text-white/70">
              {phone && (
                <li>
                  <a href={phoneLink(phone)} class="inline-flex items-center gap-2 hover:text-white">
                    <Icon name="Phone" size={16} />
                    {phone}
                  </a>
                </li>
              )}
              {telegram && (
                <li>
                  <a href={telegramLink(telegram)} class="inline-flex items-center gap-2 hover:text-white">
                    <Icon name="Send" size={16} />
                    {`@${telegram.replace(/^@/, '')}`}
                  </a>
                </li>
              )}
              {email && (
                <li>
                  <a href={`mailto:${email}`} class="inline-flex items-center gap-2 hover:text-white">
                    <Icon name="Mail" size={16} />
                    {email}
                  </a>
                </li>
              )}
            </ul>
          )
        }
      </div>
      <nav class="flex flex-wrap gap-x-6 gap-y-2 text-[15px] text-white/70" aria-label={t.nav.menu}>
        <a href={`${base}#imkoniyatlar`} class="hover:text-white">{t.nav.features}</a>
        <a href={`${base}#telegram`} class="hover:text-white">{t.nav.telegram}</a>
        <a href={`${base}#tolov`} class="hover:text-white">{t.nav.money}</a>
        <a href={`${base}#savollar`} class="hover:text-white">{t.nav.faq}</a>
        {site.appUrl && <a href={site.appUrl} class="hover:text-white">{t.nav.login}</a>}
        <a
          href={switchHref}
          hreflang={t.lang === 'uz' ? 'ru' : 'uz'}
          lang={t.lang === 'uz' ? 'ru' : 'uz'}
          class="hover:text-white">{t.nav.switchLabel}</a
        >
      </nav>
    </div>
    <div
      class="mt-10 flex flex-col gap-2 border-t border-white/10 pt-6 text-[13px] text-white/60 sm:flex-row sm:justify-between"
    >
      <p>© {year} {site.name}. {t.footer.rights}</p>
      <p class="flex gap-4">
        <a href={t.privacy.path} class="underline-offset-2 hover:text-white hover:underline">{t.privacy.linkLabel}</a>
        <span>{t.footer.country}</span>
      </p>
    </div>
  </div>
</footer>
