---
import Header from '../components/Header.astro'
import Icon from '../components/Icon.astro'
import { uz } from '../i18n/uz'
import { ru } from '../i18n/ru'
import Layout from '../layouts/Layout.astro'
---

<Layout t={uz} title={`404 — ${uz.notFound.title}`} noindex>
  <Header t={uz} />
  <main class="mx-auto grid min-h-[70vh] w-full max-w-[720px] place-items-center px-4 py-20 text-center">
    <div>
      <p class="text-[64px] leading-none font-extrabold tracking-tight text-brand">404</p>
      <h1 class="mt-4 text-[28px] font-bold text-ink">{uz.notFound.title}</h1>
      <p class="mt-2 text-muted">{uz.notFound.text}</p>
      <p class="mt-1 text-faint" lang="ru">{ru.notFound.title}. {ru.notFound.text}</p>
      <div class="mt-8 flex justify-center gap-3">
        <a
          href="/"
          class="inline-flex h-11 items-center gap-2 rounded-xl bg-brand px-5 font-semibold text-white hover:bg-brand-600"
        >
          <Icon name="ArrowLeft" size={17} strokeWidth={2.25} />
          {uz.notFound.back}
        </a>
        <a
          href="/ru"
          lang="ru"
          class="inline-flex h-11 items-center rounded-xl border border-line bg-white px-5 font-semibold text-ink hover:text-brand"
          >{ru.notFound.back}</a
        >
      </div>
    </div>
  </main>
</Layout>
